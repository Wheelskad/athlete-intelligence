{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "athlete-intelligence-mcp",
  "account_id": "5757c739bcf0dd1d26968e4dfa5df7fc",
  "main": "src/mcp-worker.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "96ded51c13b542e498f305469ee2899f"
    }
  ],
  "d1_databases": [
    {
      "binding": "TRAINING_DB",
      "database_name": "athlete-intelligence-training",
      "database_id": "d8939b83-22b7-4321-8a74-28ee795aaf36",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DATA_SOURCE": "intervals",
    "DEFAULT_TIMEZONE": "Europe/Paris",
    "MAX_HISTORY_DAYS": "42",
    "NODE_ENV": "production",
    "ATHLETE_ID": "primary"
  },
  "secrets": {
    "required": [
      "INTERVALS_API_KEY",
      "INTERVALS_ATHLETE_ID",
      "ACCESS_CLIENT_ID",
      "ACCESS_CLIENT_SECRET",
      "ACCESS_TOKEN_URL",
      "ACCESS_AUTHORIZATION_URL",
      "ACCESS_JWKS_URL",
      "ACCESS_ISSUER",
      "COOKIE_ENCRYPTION_KEY",
      "AUTHORIZED_EMAILS"
    ]
  },
  "observability": {
    "enabled": false
  }
}
